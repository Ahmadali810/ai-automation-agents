      "id": "fa585684-bc92-47c9-93d3-2392e4435eff",
      "name": "Emp. Attendence sheet"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Fixed test payroll period\nconst startDate = new Date(\"2026-08-20T00:00:00\");\nconst endDate = new Date(\"2026-09-19T23:59:59\");\n\n// Only records from 20 Aug 2026 to 19 Sep 2026\nconst records = items.filter(item => {\n  const date = new Date(item.json.Date + \"T00:00:00\");\n  return date >= startDate && date <= endDate;\n});\n\n// Group employees by ID\nconst employees = {};\n\nfor (const item of records) {\n  const data = item.json;\n  const id = data.ID;\n\n  if (!employees[id]) {\n    employees[id] = {\n      ID: data.ID,\n      Name: data.Name,\n      Department: data.Department,\n\n      P: 0,\n      A: 0,\n      H: 0,\n      HD: 0,\n      L: 0,\n\n      TotalDays: 0,\n      TotalWorkingMinutes: 0\n    };\n  }\n\n  const employee = employees[id];\n\n  // Status count\n  if (data.Status === \"P\") employee.P++;\n  if (data.Status === \"A\") employee.A++;\n  if (data.Status === \"H\") employee.H++;\n  if (data.Status === \"HD\") employee.HD++;\n  if (data.Status === \"L\") employee.L++;\n\n  employee.TotalDays++;\n\n  // Time In / Time Out\n  if (data[\"Time in\"] && data[\"Time out\"]) {\n    const [inH, inM, inS] = data[\"Time in\"].split(\":\").map(Number);\n    const [outH, outM, outS] = data[\"Time out\"].split(\":\").map(Number);\n\n    const timeInMinutes = inH * 60 + inM + inS / 60;\n    const timeOutMinutes = outH * 60 + outM + outS / 60;\n\n    let workingMinutes = timeOutMinutes - timeInMinutes;\n\n    // Handle midnight crossover\n    if (workingMinutes < 0) {\n      workingMinutes += 24 * 60;\n    }\n\n    employee.TotalWorkingMinutes += workingMinutes;\n  }\n}\n\n// Final output\nreturn Object.values(employees).map(employee => {\n\n  const totalHours = Math.floor(employee.TotalWorkingMinutes / 60);\n  const totalMinutes = Math.round(employee.TotalWorkingMinutes % 60);\n\n  return {\n    json: {\n      ID: employee.ID,\n      Name: employee.Name,\n      Department: employee.Department,\n\n      PayrollPeriod: \"2026-08-20 to 2026-09-19\",\n\n      P: employee.P,\n      A: employee.A,\n      H: employee.H,\n      HD: employee.HD,\n      L: employee.L,\n\n      TotalDays: employee.TotalDays,\n\n      TotalWorkingHours:\n        `${totalHours} hours ${totalMinutes} minutes`\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        16
      ],
      "id": "e9147a76-e955-4ff8-9948-122cd265ce6f",
      "name": "Calculate Attendance"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json;\n\n  const monthlySalary = Number(data.Salary) || 0;\n\n  // Always calculate salary deduction on 30 days\n  const perDaySalary = monthlySalary / 30;\n\n  const leave = Number(data.L) || 0;\n  const absent = Number(data.A) || 0;\n  const halfday = Number(data.HD) || 0;\n  const present = Number(data.P) || 0;\n  const holiday = Number(data.H) || 0;\n\n  // Deduction days\n  const deductionDays =\n    leave +\n    absent +\n    (halfday * 0.5);\n\n  // Salary deduction\n  const salaryDeduction =\n    perDaySalary * deductionDays;\n\n  // Final salary\n  const totalSalary =\n    monthlySalary - salaryDeduction;\n\n  const [startMonth, endMonth] =\n    data.PayrollPeriod.split(\" to \");\n\n  return {\n    json: {\n      ID: data.ID,\n      Name: data.Name,\n      Department: data.Department,\n\n      \"Salary Detuction\": Number(salaryDeduction.toFixed(2)),\n\n      Leave: leave,\n      Absent: absent,\n      Halfday: halfday,\n      Present: present,\n      Holiday: holiday,\n\n      \"Total Salary\": Number(totalSalary.toFixed(2)),\n\n      \"Start month\": startMonth,\n      \"End month\": endMonth\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
