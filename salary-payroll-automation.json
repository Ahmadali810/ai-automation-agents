    {
      "parameters": {
        "jsCode": "function money(value) {\n  return Number(value || 0).toLocaleString(\"en-US\", {\n    minimumFractionDigits: 2,\n    maximumFractionDigits: 2\n  });\n}\n\nconst items = $input.all().map(item => item.json);\n\nconst rows = items.map(employee => `\n  <tr>\n    <td><b>${employee.ID || ''}</b></td>\n    <td style=\"text-align: left;\"><b>${employee.Name || ''}</b></td>\n    <td>${employee.Department || ''}</td>\n    <td style=\"text-align: right;\">${money(employee.Salary)}</td>\n    <td style=\"text-align: right; color: #dc2626;\">${money(employee[\"Salary Detuction\"])}</td>\n    <td>${employee.Leave || 0}</td>\n    <td><b style=\"color: #dc2626;\">${employee.Absent || 0}</b></td>\n    <td>${employee.Halfday || 0}</td>\n    <td><b style=\"color: #16a34a;\">${employee.Present || 0}</b></td>\n    <td>${employee.Holiday || 0}</td>\n    <td style=\"text-align: right; color: #16a34a;\"><b>${money(employee[\"Total Salary \"] || employee.Salary)}</b></td>\n  </tr>\n`).join(\"\");\n\nconst html = `\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  @page { size: A4 landscape; margin: 10mm; }\n  body { font-family: Arial, sans-serif; font-size: 11px; color: #1e293b; }\n  h2 { margin: 0 0 5px 0; text-align: center; }\n  p.period { text-align: center; color: #64748b; margin-bottom: 15px; }\n  table { width: 100%; border-collapse: collapse; }\n  th { background: #0f172a; color: white; padding: 8px; text-align: center; }\n  td { padding: 6px 8px; border-bottom: 1px solid #e2e8f0; text-align: center; }\n  tr:nth-child(even) { background-color: #f8fafc; }\n</style>\n</head>\n<body>\n  <h2>EMPLOYEE PAYROLL REPORT</h2>\n  <p class=\"period\">Period: ${items[0][\"Start month\"] || ''} to ${items[0][\"End month\"] || ''}</p>\n  <table>\n    <thead>\n      <tr>\n        <th>ID</th><th style=\"text-align:left;\">Name</th><th>Department</th>\n        <th style=\"text-align:right;\">Salary</th><th style=\"text-align:right;\">Deduction</th>\n        <th>Leave</th><th>Absent</th><th>Halfday</th><th>Present</th><th>Holiday</th>\n        <th style=\"text-align:right;\">Total Salary</th>\n      </tr>\n    </thead>\n    <tbody>${rows}</tbody>\n  </table>\n</body>\n</html>\n`;\n\n// Return as binary HTML file inside n8n\nreturn [\n  {\n    json: { success: true },\n    binary: {\n      data: {\n        data: Buffer.from(html).toString('base64'),\n        mimeType: 'text/html',\n        fileName: 'report.html'\n      }\n    }\n  }\n];"
      },
