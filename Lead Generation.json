      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -1120,
        96
      ],
      "id": "e4fa1d72-1511-4028-aa68-ceecfd89d015",
      "name": "Get data from web",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const browserHeaders = {\n  \"User-Agent\":\n    \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36\",\n  Accept:\n    \"text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,image/apng,*/*;q=0.8\",\n  \"Accept-Language\": \"en-US,en;q=0.9\",\n  Referer: \"https://www.google.com/\",\n  Connection: \"keep-alive\",\n  \"Cache-Control\": \"max-age=0\",\n};\n\nconst emailRegex =\n  /[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,}/g;\n\nconst badDomainRegex =\n  /(?:example|invalid|localhost|localdomain|sentry|mlsgrid|facebookmail|instagram|linkedin|github|google)\\.(?:com|net|org|io|co|us|info|app|dev)$/i;\n\nfunction cleanEmail(email) {\n  return String(email || \"\")\n    .trim()\n    .replace(/[\\u200B-\\u200F\\uFEFF]/g, \"\")\n    .replace(/^[<\\s\"']+|[>\\s\"']+$/g, \"\")\n    .replace(/[.,;:)\\]}]+$/, \"\");\n}\n\nfunction isVerifiedEmail(email) {\n  email = cleanEmail(email).toLowerCase();\n  if (!emailRegex.test(email)) return false;\n  if (email.length > 254) return false;\n  if (email.includes(\"..\")) return false;\n  if (/%[0-9A-F]{2}/i.test(email)) return false;\n  const [local, domain] = email.split(\"@\");\n  if (!local || !domain) return false;\n  if (local.length > 64 || domain.length > 253) return false;\n  if (/^[.\\-]/.test(local) || /[.\\-]$/.test(local)) return false;\n  if (badDomainRegex.test(domain)) return false;\n  if (/[^ -~]/.test(email)) return false;\n  return true;\n}\n\nfunction decodeEntities(str) {\n  return str\n    .replace(/&nbsp;/gi, \" \")\n    .replace(/&amp;/gi, \"&\")\n    .replace(/&lt;/gi, \"<\")\n    .replace(/&gt;/gi, \">\")\n    .replace(/&#(\\d+);/g, (_, n) => String.fromCharCode(n))\n    .replace(/&#x([0-9A-Fa-f]+);/g, (_, n) =>\n      String.fromCharCode(parseInt(n, 16))\n    );\n}\n\nfunction extractEmailsFromText(text) {\n  const normalized = decodeEntities(text || \"\");\n  const matches = normalized.match(emailRegex) || [];\n  return [...new Set(matches.map(cleanEmail))].filter(isVerifiedEmail);\n}\n\nfunction extractSection(html, tag) {\n  const regex = new RegExp(`<${tag}[^>]*>[\\\\s\\\\S]*?<\\\\/${tag}>`, \"i\");\n  const match = html.match(regex);\n  return match ? match[0] : \"\";\n}\n\nfunction findMailtoEmails(html) {\n  const mailto = [];\n  const regex = /mailto:([^\"'<>?\\s]+)/gi;\n  let match;\n  while ((match = regex.exec(html))) {\n    mailto.push(cleanEmail(match[1]));\n  }\n  return [...new Set(mailto)].filter(isVerifiedEmail);\n}\n\nfunction getUrlFromItems(items, pattern) {\n  for (const item of items) {\n    const candidate =\n      item?.json?.url ||\n      item?.json?.href ||\n      item?.json?.link ||\n      item?.json?.source ||\n      item?.json?.website ||\n      \"\";\n    if (typeof candidate === \"string\" && pattern.test(candidate)) {\n      return candidate;\n    }\n  }\n  return null;\n}\n\nfunction normalizeUrl(url) {\n  if (!url) return null;\n  try {\n    return new URL(url).href;\n  } catch {\n    return null;\n  }\n}\n\nasync function fetchHtml(url) {\n  const response = await fetch(url, { headers: browserHeaders });\n  if (!response.ok) throw new Error(`Fetch failed ${response.status}`);\n  return response.text();\n}\n\nfunction scoreEmailContext(html, email) {\n  const idx = html.indexOf(email);\n  if (idx < 0) return 0;\n  const fragment = html.slice(Math.max(0, idx - 120), idx + email.length + 120);\n  const contactWords = /(contact|reach|email|office|phone|support|get in touch|customer service|team|help)/i;\n  return contactWords.test(fragment) ? 2 : 1;\n}\n\nfunction findBestEmail(html, sections = [\"header\", \"footer\", \"body\"]) {\n  const candidates = [];\n  for (const section of sections) {\n    const text =\n      section === \"body\"\n        ? html\n        : extractSection(html, section) || html;\n    findMailtoEmails(text).forEach((email) =>\n      candidates.push({\n        email,\n        score: scoreEmailContext(text, email) + (section === \"header\" || section === \"footer\" ? 2 : 0),\n      })\n    );\n    extractEmailsFromText(text).forEach((email) =>\n      candidates.push({\n        email,\n        score: scoreEmailContext(text, email) + (section === \"header\" || section === \"footer\" ? 1 : 0),\n      })\n    );\n  }\n  const unique = new Map();\n  for (const candidate of candidates) {\n    if (!unique.has(candidate.email) || unique.get(candidate.email) < candidate.score) {\n      unique.set(candidate.email, candidate.score);\n    }\n  }\n  return [...unique.entries()]\n    .sort((a, b) => b[1] - a[1])\n    .map(([email]) => email)[0] || null;\n}\n\nasync function findImportantEmail(items = []) {\n  const contactUrl =\n    normalizeUrl(\n      getUrlFromItems(items, /contact|kontakt|get[-_\\s]?in[-_\\s]?touch|support/i)\n    ) || null;\n  const homeUrl =\n    normalizeUrl(getUrlFromItems(items, /^https?:\\/\\/[^/]+\\/?$/i)) ||\n    normalizeUrl(getUrlFromItems(items, /homepage|home/i));\n  const aboutUrl =\n    normalizeUrl(getUrlFromItems(items, /about|impressum|company|team/i)) ||\n    null;\n\n  if (contactUrl) {\n    try {\n      const html = await fetchHtml(contactUrl);\n      const email = findBestEmail(html, [\"header\", \"footer\", \"body\"]);\n      if (email) return { email, source: contactUrl };\n    } catch {}\n  }\n\n  if (homeUrl) {\n    try {\n      const html = await fetchHtml(homeUrl);\n      const headerEmail = findBestEmail(html, [\"header\"]);\n      if (headerEmail) return { email: headerEmail, source: `${homeUrl} header` };\n      const footerEmail = findBestEmail(html, [\"footer\"]);\n      if (footerEmail) return { email: footerEmail, source: `${homeUrl} footer` };\n    } catch {}\n  }\n\n  if (aboutUrl) {\n    try {\n      const html = await fetchHtml(aboutUrl);\n      const aboutEmail = findBestEmail(html, [\"body\"]);\n      if (aboutEmail) return { email: aboutEmail, source: aboutUrl };\n    } catch {}\n  }\n\n  for (const item of items) {\n    const html = item?.json?.body || item?.json?.data || item?.json?.html || \"\";\n    const email = findBestEmail(String(html), [\"body\"]);\n    if (email) return { email, source: \"local\" };\n  }\n\n  return { email: null, source: \"none\" };\n}\n\nreturn [\n  {\n    json: await findImportantEmail(items),\n  },\n];"
      },
