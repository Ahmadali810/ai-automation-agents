    {
      "parameters": {
        "jsCode": "return items.flatMap(item => {\n\n  const raw = item.json;\n\n  // har possible array ko detect karo\n  const list = raw.local_results \n            || raw.results \n            || raw.places \n            || raw.data \n            || [raw];\n\n  return list.map(data => {\n\n    return {\n      json: {\n        category: data.type || data[\"type_ids[0]\"] || \"\",\n        address: data.address || \"\",\n        phone: data.phone || \"\",\n        website: data.website || \"\",\n        name: data.title || data.name || \"\",\n        reviews: data.reviews || \"\",\n        rating: data.rating || \"\",\n\n        // optional useful fields\n        open_status: data.open_state || \"\",\n        thumbnail: data.thumbnail || \"\",\n\n        // debugging ke liye (baad mein hata dena)\n        full_data: data\n      }\n    };\n\n  });\n\n});"
      },
