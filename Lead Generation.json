    {
      "parameters": {
        "jsCode": "let itemsData = items.map(item => item.json);\n\n// emails collect (sheet already send ho chuki hai, but safe side)\nlet emails = [];\nlet nextLinks = [];\n\nitemsData.forEach(d => {\n\n  if (d.Mail) emails.push(d.Mail);\n\n  // agar future crawling links hon\n  if (d.next_urls) {\n    if (Array.isArray(d.next_urls)) {\n      nextLinks.push(...d.next_urls);\n    }\n  }\n\n});\n\n// remove duplicates\nconst uniqueEmails = [...new Set(emails.map(e => e.toLowerCase()))];\nconst uniqueLinks = [...new Set(nextLinks)];\n\nreturn [\n  {\n    json: {\n      status: \"round_completed\",\n\n      // 🔥 LOOP CONTROL SIGNAL\n      continue_loop: uniqueLinks.length > 0,\n\n      next_urls: uniqueLinks,\n\n      emails_collected: uniqueEmails.length\n    }\n  }\n];"
      },
