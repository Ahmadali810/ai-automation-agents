        "jsCode": "// n8n Code Node (JavaScript)\n// Har item par loop chalaye ga jo pichle node se aa raha hai\n\nreturn items.map(item => {\n  // Check karte hain ke Price maujood hai ya nahi\n  if (item.json.Price) {\n    \n    // 1. Agar sirf \"Rs\" add karna hai:\n    let formattedPrice = \"Rs \" + item.json.Price;\n\n    /* 2. Optional: Agar aap comma (,) khatam karna chahte hain to neche wali line use karein:\n    let formattedPrice = \"Rs \" + item.json.Price.replace(/,/g, ''); \n    */\n\n    item.json.Price = formattedPrice;\n  }\n\n  return item;\n});"
