    {
      "parameters": {
        "jsCode": "const input = $json;\n\n// 1) collect all values from sub-pages.url\nlet urls = [];\n\n// case 1: proper array\nif (Array.isArray(input[\"sub-pages.url\"])) {\n  urls = input[\"sub-pages.url\"];\n}\n\n// case 2: indexed object like sub-pages.url[82]\nelse {\n  for (const key in input) {\n    if (key.startsWith(\"sub-pages.url\")) {\n      urls.push(input[key]);\n    }\n  }\n}\n\n// 2) clean + filter product URLs\nconst productUrls = urls\n  .filter(url => typeof url === \"string\" && url.includes(\"/products/\"));\n\n// 3) return n8n items\nreturn productUrls.map(url => ({\n  json: {\n    product_url: url\n  }\n}));"
      },
